{
  "env": {
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Edit(*)",
      "Bash(cd:*)",
      "Bash(ls:*)",
      "Bash(ls -la:*)",
      "Bash(cat:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(tree:*)",
      "Bash(find:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(chmod:*)",
      "Skill(skill-creator)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(wc:*)",
      "Bash(yes:*)",
      "Bash(echo:*)",
      "Bash(sleep:*)",
      "Bash(jq:*)",
      "Bash(test:*)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__get-library-docs",
      "mcp__context7__query-docs"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(sudo:*)",
      "Read(.env.*)",
      "Read(.env)",
      "Bash(gh auth token:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cat | jq -r '[\"--title\", .title, \"--body\", .message] | @sh' | xargs /Applications/cmux.app/Contents/Resources/bin/cmux notify"
          },
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Blow.aiff &"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Applications/cmux.app/Contents/Resources/bin/cmux notify --title 'Claude Code' --body '作業が完了しました。'"
          },
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Blow.aiff &"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bunx -y ccstatusline@2.2.32",
    "padding": 0
  },
  "enabledPlugins": {
    "example-skills@anthropic-agent-skills": true,
    "serena@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "coderabbit@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "chrome-devtools-mcp@chrome-devtools-plugins": true,
    "slack@claude-plugins-official": true,
    "explainer@explainer": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "chrome-devtools-plugins": {
      "source": {
        "source": "github",
        "repo": "ChromeDevTools/chrome-devtools-mcp"
      }
    },
    "explainer": {
      "source": {
        "source": "github",
        "repo": "mizchi/explainer"
      }
    }
  },
  "language": "Japanese",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "preferredNotifChannel": "terminal_bell",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
