# .gitconfig.local - 個人用Git設定
# 配置先: ~/.config/git/config.local (make link で自動生成されます)
# このファイルは git config から自動的にインクルードされます
# git 管理外なので、秘匿情報はここに置いてください

[user]
	name = あなたの名前
	email = あなたのメールアドレス@example.com

# 個人用Gitエイリアス（オプション）
[alias]
	# lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit

# 個人用Git設定（オプション）
[push]
	default = simple
[pull]
	rebase = true

# 作業用設定（必要に応じてコメントを外してください）
# [includeIf "gitdir:~/work/"]
#	path = ~/.gitconfig.work