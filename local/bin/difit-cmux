#!/bin/bash
# where: local/bin/difit-cmux
# what: cmux + difit 連携スクリプト
# why: Claude Code等のAIエージェントが生成したコードのdiffをGitHub風UIでレビューするため
#
# Dependencies:
# - cmux https://cmux.app/
# - difit https://github.com/yoshiko-pg/difit
#
# Setup:
# 1. Install cmux from https://cmux.app/ and move to /Applications/
#    Change "Socket Control Mode" to "Automation Mode"
# 2. Install difit: managed by mise (config/mise/config.toml の "npm:difit")
# 3. This script is automatically symlinked to ~/.local/bin/ by link.sh
# 4. Bind to Hyper + D via Karabiner Elements
#
# Usage:
# Run this script while cmux is focused on a git repository pane.
# The script will:
# - Detect the current branch and default branch
# - Show diff against merge-base (for feature branches)
# - Show diff against HEAD (for default branch or detached HEAD)
# - Open the result in a cmux browser split (port is auto-assigned per run,
#   so several worktrees can be reviewed in parallel)
# - Automatically shut down the difit server when the browser pane is closed
#
# Reference: https://gist.github.com/azu/cef84c98aeef832d43dfb640c7e321f5

set -euo pipefail

# Karabiner の shell_command は launchd の最小 PATH で動くため、mise の shim を先頭に足す
# (difit とその実行に必要な node は shim 経由で解決される)
export PATH="${XDG_DATA_HOME:-$HOME/.local/share}/mise/shims:$PATH"

CMUX="/Applications/cmux.app/Contents/Resources/bin/cmux"
# 希望ポート。使用中なら difit が空きポートを自動で選ぶ
DIFIT_PORT=4966

# Verify dependencies
if [[ ! -x "$CMUX" ]]; then
    echo "Error: cmux is not installed at $CMUX" >&2
    exit 1
fi

if ! command -v difit &>/dev/null; then
    echo "Error: difit is not installed. Run: mise install" >&2
    exit 1
fi

# Get the working directory of the currently focused cmux pane
targetDir=$("$CMUX" sidebar-state | awk -F= '/^focused_cwd=/{print $2}')

if [[ -z "$targetDir" ]]; then
    echo "Error: Could not detect focused_cwd from cmux sidebar-state" >&2
    exit 1
fi

cd "$targetDir" || exit 1

# Verify this is a git repository
if ! git rev-parse --is-inside-work-tree &>/dev/null; then
    "$CMUX" notify --title "Difit" --body "Error: Not a git repository: $targetDir"
    exit 1
fi

# Provide immediate feedback
"$CMUX" notify --title "Difit" --body "Loading diff: $targetDir"

currentBranch=$(git rev-parse --abbrev-ref HEAD)

# Detect default branch (origin/HEAD -> origin/main -> origin/master)
defaultBranch=$(git symbolic-ref refs/remotes/origin/HEAD --short 2>/dev/null || true)

if [[ -z "$defaultBranch" ]]; then
    if git rev-parse --verify origin/main &>/dev/null; then
        defaultBranch="origin/main"
    elif git rev-parse --verify origin/master &>/dev/null; then
        defaultBranch="origin/master"
    fi
fi

# 並列実行時に他のレビューのサーバーを巻き込まないよう、ポートではなく PID で止める
difitPid=""
kill_difit() {
    [[ -n "$difitPid" ]] && kill "$difitPid" 2>/dev/null || true
}

trap kill_difit EXIT INT TERM

difitArgs=(--no-open --clean --include-untracked --background --port "$DIFIT_PORT")

if [[ -z "$defaultBranch" ]] || [[ "$currentBranch" == "${defaultBranch#origin/}" ]]; then
    # On the default branch or no remote — diff working directory against HEAD
    difitOut=$(difit working "${difitArgs[@]}")
else
    mergeBase=$(git merge-base HEAD "$defaultBranch" 2>/dev/null || true)

    if [[ -z "$mergeBase" ]]; then
        difitOut=$(difit working "${difitArgs[@]}")
    else
        difitOut=$(difit . "$mergeBase" "${difitArgs[@]}")
    fi
fi

# --background は起動済みサーバーの情報を JSON で返す: {"port":4966,"url":"...","pid":123}
difitPid=$(grep -o '"pid" *: *[0-9]*' <<<"$difitOut" | grep -o '[0-9]*$' || true)
difitPort=$(grep -o '"port" *: *[0-9]*' <<<"$difitOut" | grep -o '[0-9]*$' || true)

if [[ -z "$difitPid" || -z "$difitPort" ]]; then
    echo "Error: could not parse difit output: $difitOut" >&2
    exit 1
fi

# Open in a cmux browser split and get the surface ID
browserSurface=$("$CMUX" --json browser open-split "http://localhost:${difitPort}/" | grep -o '"ref" *: *"surface:[^"]*"' | head -1 | grep -o 'surface:[0-9]*')

if [[ -z "$browserSurface" ]]; then
    echo "Warning: Could not get browser surface ID, difit server running in background (pid: $difitPid)" >&2
    # 手動でブラウザから開けるよう、終了時に止めない
    difitPid=""
    exit 0
fi

# Wait until the browser pane is closed, then shut down the server
while "$CMUX" surface-health 2>&1 | grep -q "$browserSurface"; do
    sleep 1
done

kill_difit
